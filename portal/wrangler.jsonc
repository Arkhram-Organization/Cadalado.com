{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Portal de cadalado.com: sitio estático (sin servidor), solo archivos de public/.
  "name": "cadalado",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
  // Dominio propio: agregarlo desde el panel (Settings → Domains & Routes → Custom domain),
  // o descomentar esto cuando cadalado.com esté en la cuenta de Cloudflare:
  // , "routes": [{ "pattern": "cadalado.com", "custom_domain": true }, { "pattern": "www.cadalado.com", "custom_domain": true }]
}
