{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/casino/mesa/:code",
      "destination": "/casino/index.html"
    },
    {
      "source": "/ajedrez/api/:ruta*",
      "destination": "/api/juegos/ajedrez?ruta=:ruta*"
    },
    {
      "source": "/api/truco/:ruta*",
      "destination": "/api/juegos/truco?ruta=:ruta*"
    },
    {
      "source": "/api/club/:ruta*",
      "destination": "/api/club?ruta=:ruta*"
    },
    {
      "source": "/api/carrera/:ruta*",
      "destination": "/api/juegos/carrera?ruta=:ruta*"
    },
    {
      "source": "/api/royale/:ruta*",
      "destination": "/api/juegos/royale?ruta=:ruta*"
    },
    {
      "source": "/api/casino/:ruta*",
      "destination": "/api/juegos/casino?ruta=:ruta*"
    },
    {
      "source": "/api/haxball/:ruta*",
      "destination": "/api/juegos/haxball?ruta=:ruta*"
    },
    {
      "source": "/api/memes/:ruta*",
      "destination": "/api/juegos/memes?ruta=:ruta*"
    },
    {
      "source": "/ajedrez/game/:id",
      "destination": "/ajedrez/index"
    },
    {
      "source": "/ajedrez/local",
      "destination": "/ajedrez/index"
    },
    {
      "source": "/truco/sala/:code",
      "destination": "/truco/index"
    },
    {
      "source": "/haxball/sala/:code",
      "destination": "/haxball/index"
    },
    {
      "source": "/memes/sala/:code",
      "destination": "/memes/index"
    },
    {
      "source": "/casino/sala/:code",
      "destination": "/casino/index"
    },
    {
      "source": "/carrera/sala/:code",
      "destination": "/carrera/index"
    },
    {
      "source": "/royale/sala/:code",
      "destination": "/royale/index"
    },
    {
      "source": "/casino/mesa/:code",
      "destination": "/casino/index"
    }
  ],
  "redirects": [
    {
      "source": "/creadores",
      "destination": "/equipo",
      "permanent": true
    }
  ]
}
