{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chessort",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // El "name" es interno: no lo cambies, Cloudflare publica este Worker con ese nombre.
  // Dominio propio (descomentar cuando cadalado.com esté en la cuenta de Cloudflare):
  // "routes": [{ "pattern": "ajedrez.cadalado.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "Lobby"] }
  ],
  "observability": { "enabled": true }
}
